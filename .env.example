# MySQL (RDS) connection
DB_URL=mysql+pymysql://admin:changeme@localhost:3306/gvmc

# S3
S3_BUCKET=gvmc-sw14-data
AWS_REGION=ap-south-1

# Bedrock (called cross-region — see plan for rationale).
# NOTE: these two models require the cross-region "inference profile" id (us.* prefix),
# not the bare model id — Bedrock rejects on-demand invocation of the bare id with
# "Invocation ... with on-demand throughput isn't supported".
BEDROCK_REGION=us-east-1
BEDROCK_EXPLAIN_MODEL_ID=us.meta.llama4-scout-17b-instruct-v1:0
BEDROCK_CHAT_MODEL_ID=us.meta.llama3-3-70b-instruct-v1:0

# Optional: EC2 instance running the Sentinel-2/OSM pipeline, for real /admin/refresh SSM trigger
PIPELINE_EC2_INSTANCE_ID=

ENVIRONMENT=staging

# Local dev server only
PORT=8000
